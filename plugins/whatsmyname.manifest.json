{
  "identifier": "run.vineyard.pluginpacks.whatsmyname",
  "content_type": "vineyard:pluginpack",
  "name": "WhatsMyName",
  "version": "2.2.1",
  "description": "Username enumeration across ~700 sites using the WhatsMyName dataset (https://github.com/WebBreacher/WhatsMyName, CC-BY-SA-4.0). Desktop only.",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "at-sign",
  "platforms": {
    "primary": "desktop",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    },
    "desktop": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs",
      "min_app_version": "0.1.0"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.whatsmyname",
      "content_type": "vineyard:plugin",
      "name": "WhatsMyName Account Search",
      "version": "2.2.1",
      "description": "Checks whether each selected handle is registered on ~700 sites from the WhatsMyName dataset. Takes Handle, Account, Social Account or Email Address nodes (an email address uses its local part). Creates a Handle node (unless the seed is one), linked \"uses handle\" from the seed, and one Account per site where the handle was found (username, platform, profile_url), linked \"same handle\" from the Handle; likely false positives are counted as blocked and not added. Desktop only.",
      "icon": "at-sign",
      "platforms": {
        "primary": "desktop",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "handle"
          },
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "account"
          },
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "email_address"
          },
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "account"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "handle"
          },
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "account"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://cdn.jsdelivr.net/gh/WebBreacher/WhatsMyName@main/wmn-data.json",
            "methods": [
              "GET"
            ],
            "purpose": "Fetch the latest WhatsMyName site list (CDN, CORS-enabled)."
          }
        ],
        "web_probe": {
          "purpose": "Request each WhatsMyName site directly to see whether the handle resolves to a profile. Desktop only; the request is anonymous (no cookies), never follows redirects, and cannot reach private or loopback addresses."
        }
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
